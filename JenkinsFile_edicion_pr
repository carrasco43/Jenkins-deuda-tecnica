// Pipeline: Corregir deuda tecnica / vulnerabilidades y abrir Pull Request
// -- Version adaptada para correr en el nodo Jenkins que corre en la EC2
//    con salida a internet y Docker instalado localmente (no dentro de
//    Docker Compose como en el POC local).
//
// Mismas diferencias que en Jenkinsfile-plan-deuda-tecnica-ec2:
//   1. agent { label 'ec2-internet' } -- CAMBIA 'ec2-internet' por el label
//      real de tu nodo.
//   2. Bind mounts normales (-v "$(pwd):$(pwd)") en vez de
//      --volumes-from jenkins-poc, porque Jenkins ya corre directo en la
//      EC2 (no dentro de otro contenedor).
//   3. Red docker dedicada "qwen-net" en vez de "downloads_default".
//      Crearla una sola vez en la EC2: docker network create qwen-net
//
// Logica identica a la version local: crea rama temporal, deja que Qwen
// edite en modo auto-edit, y si hubo cambios reales (excluyendo los
// archivos de trabajo propios del pipeline) hace commit + push + abre PR
// contra REPO_BRANCH. Nunca mergea solo.
//
// Requiere en la EC2: Docker instalado, usuario SSH del agente Jenkins en
// el grupo "docker", red "qwen-net" ya creada.
// Requiere en Jenkins: "File Parameter Plugin", y las credenciales
// github-pat (con permiso de escritura: push + crear PR), aws-creds,
// litellm-proxy-key. Ajustá los nombres si en esta instancia los llamaste
// distinto.
 
pipeline {
  agent { label 'ec2-internet' }
 
  parameters {
    string(name: 'REPO_URL', defaultValue: 'https://github.com/carrasco43/cowork-spaces-frontend.git', description: 'Repo a corregir')
    string(name: 'REPO_BRANCH', defaultValue: 'develop', description: 'Rama base: de donde se parte la rama temporal, y a donde apunta el Pull Request')
    choice(name: 'FUENTE', choices: ['SONAR', 'FORTIFY'], description: 'De cual herramienta viene el archivo que estas subiendo')
    choice(name: 'SEVERIDAD_FILTRO', choices: ['TODAS', 'BLOCKER', 'CRITICAL', 'HIGH', 'MAJOR', 'MEDIUM', 'MINOR', 'LOW', 'INFO'], description: 'Solo corregir hallazgos de esta severidad. TODAS = sin filtro')
    string(name: 'CANTIDAD_MAX', defaultValue: '3', description: 'Maximo de hallazgos a corregir en esta corrida (los mas severos primero). Vacio = sin limite')
    stashedFile 'INSUMO_FILE'
  }
 
  stages {
 
    stage('Guardar insumo antes del checkout') {
      steps {
        withFileParameter('INSUMO_FILE') {
          sh 'cp "$INSUMO_FILE" /tmp/insumo.bin || true'
        }
      }
    }
 
    stage('Checkout') {
      steps {
        git branch: "${params.REPO_BRANCH}",
            url: "${params.REPO_URL}",
            credentialsId: 'github-pat'
      }
    }
 
    stage('Restaurar insumo') {
      steps {
        sh 'cp /tmp/insumo.bin insumo.bin 2>/dev/null || true'
      }
    }
 
    stage('Crear rama temporal') {
      steps {
        script {
          env.FIX_BRANCH = "qwen/fix-deuda-tecnica-${System.currentTimeMillis()}"
        }
        sh 'git checkout -b "$FIX_BRANCH"'
        echo "Rama temporal creada: ${env.FIX_BRANCH}"
      }
    }
 
    stage('Convertir insumo (xlsx/csv) a texto plano') {
      steps {
        writeFile file: 'convertir_insumo.py', text: '''
import sys
import pandas as pd
 
fuente = sys.argv[1] if len(sys.argv) > 1 else "DESCONOCIDO"
severidad_filtro = sys.argv[2].strip().upper() if len(sys.argv) > 2 and sys.argv[2].strip() else "TODAS"
cantidad_max_raw = sys.argv[3].strip() if len(sys.argv) > 3 else ""
cantidad_max = int(cantidad_max_raw) if cantidad_max_raw.isdigit() else None
 
RANKING = {
    "BLOCKER": 0,
    "CRITICAL": 1,
    "HIGH": 1,
    "MAJOR": 2,
    "MEDIUM": 2,
    "MINOR": 3,
    "LOW": 3,
    "INFO": 4,
}
 
def cargar(path):
    with open(path, "rb") as f:
        head = f.read(4)
    if head[:2] == b"PK":
        return pd.read_excel(path)
    return pd.read_csv(path)
 
def encontrar_columna_severidad(df):
    for col in df.columns:
        if "sever" in str(col).lower():
            return col
    return None
 
with open("hallazgos.txt", "w", encoding="utf-8") as out:
    try:
        df = cargar("insumo.bin")
        total_original = len(df)
        col_sev = encontrar_columna_severidad(df)
 
        if col_sev is None:
            out.write(f"=== Aviso: no se encontro columna de severidad, no se pudo filtrar/ordenar ===\\n\\n")
        else:
            if severidad_filtro != "TODAS":
                df = df[df[col_sev].astype(str).str.strip().str.upper() == severidad_filtro]
            df = df.assign(_rank=df[col_sev].astype(str).str.strip().str.upper().map(RANKING).fillna(99))
            df = df.sort_values("_rank").drop(columns="_rank")
 
        if cantidad_max is not None:
            df = df.head(cantidad_max)
 
        out.write(f"=== Hallazgos de {fuente} (severidad={severidad_filtro}, mostrando {len(df)} de {total_original} filas) ===\\n")
        out.write(df.to_string(index=False))
        out.write("\\n\\n")
    except FileNotFoundError:
        out.write("Sin insumo provisto.\\n")
    except Exception as e:
        out.write(f"=== No se pudo leer el archivo de {fuente}: {e} ===\\n\\n")
 
print("Conversion completa.")
'''
        sh '''
          docker run --rm --user root \
            -v "$(pwd):$(pwd)" \
            -w "$(pwd)" \
            python:3.11-slim \
            bash -c "pip install --quiet pandas openpyxl && python3 convertir_insumo.py \\"$FUENTE\\" \\"$SEVERIDAD_FILTRO\\" \\"$CANTIDAD_MAX\\""
 
          echo "== hallazgos.txt generado =="
          cat hallazgos.txt
        '''
      }
    }
 
    stage('Preparar configuracion de LiteLLM') {
      steps {
        writeFile file: 'litellm-config.yaml', text: "model_list:\n  - model_name: qwen-coder\n    litellm_params:\n      model: bedrock/qwen.qwen3-coder-next\n      aws_region_name: us-east-1\n\ngeneral_settings:\n  master_key: os.environ/LITELLM_PROXY_KEY\n"
      }
    }
 
    stage('Arrancar LiteLLM (contenedor efimero)') {
      steps {
        withCredentials([
          usernamePassword(credentialsId: 'aws-creds', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY'),
          string(credentialsId: 'litellm-proxy-key', variable: 'LITELLM_PROXY_KEY')
        ]) {
          sh '''
            docker run -d \
              --name litellm-proxy-temp \
              -v "$(pwd):$(pwd)" \
              --network qwen-net \
              -e PYTHONUNBUFFERED=1 \
              -e AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID \
              -e AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY \
              -e LITELLM_PROXY_KEY=$LITELLM_PROXY_KEY \
              ghcr.io/berriai/litellm:main-latest \
              --config "$(pwd)/litellm-config.yaml" --port 4000
            sleep 20
 
            echo "== Estado del contenedor litellm-proxy-temp =="
            docker ps -a --filter name=litellm-proxy-temp
            echo "== Logs de litellm-proxy-temp =="
            docker logs litellm-proxy-temp
          '''
        }
      }
    }
 
    stage('Corregir con Qwen (modo edicion)') {
      steps {
        withCredentials([string(credentialsId: 'litellm-proxy-key', variable: 'LITELLM_PROXY_KEY')]) {
          sh '''
            cat > prompt.txt << 'EOF'
Te paso hallazgos de analisis estatico (Sonar o Fortify) sobre este repositorio.
 
Para cada hallazgo:
- Si es un problema real, corregilo directamente en el archivo indicado
  (archivo/linea). Hace el cambio minimo necesario para resolverlo, sin
  refactors que no vengan al caso y sin tocar archivos no relacionados.
- Si sospechas que es un FALSO POSITIVO, no modifiques ese archivo y
  explicalo en el resumen final.
 
No inventes hallazgos que no esten en la lista de abajo.
 
Al final, escribi un resumen corto: que corregiste (archivo por archivo) y
que marcaste como falso positivo sin tocar.
 
Hallazgos:
EOF
            cat hallazgos.txt >> prompt.txt
 
            docker run --rm --user root \
              -v "$(pwd):$(pwd)" --network qwen-net \
              -w "$(pwd)" \
              -e OPENAI_BASE_URL=http://litellm-proxy-temp:4000 \
              -e OPENAI_API_KEY=$LITELLM_PROXY_KEY \
              -e OPENAI_MODEL=qwen-coder \
              node:20 \
              npx -y @qwen-code/qwen-code \
                --prompt "$(cat prompt.txt)" \
                --approval-mode auto-edit \
              > cambios.txt
 
            echo "== Resumen de Qwen =="
            cat cambios.txt
          '''
        }
      }
    }
 
    stage('Ver que cambio') {
      steps {
        sh '''
          echo "== git status (solo codigo real) =="
          git status --porcelain -- . \
            ':!insumo.bin' ':!hallazgos.txt' ':!prompt.txt' ':!cambios.txt' \
            ':!resumen.txt' ':!diff-stat.txt' ':!git-status.txt' \
            ':!litellm-config.yaml' ':!convertir_insumo.py' ':!crear_pr.py' \
            > git-status.txt
          cat git-status.txt
 
          echo "== archivos modificados (diff --stat, solo codigo real) =="
          git diff --stat -- . \
            ':!insumo.bin' ':!hallazgos.txt' ':!prompt.txt' ':!cambios.txt' \
            ':!resumen.txt' ':!diff-stat.txt' ':!git-status.txt' \
            ':!litellm-config.yaml' ':!convertir_insumo.py' ':!crear_pr.py' \
            > diff-stat.txt || true
          cat diff-stat.txt
        '''
        script {
          env.HAY_CAMBIOS = sh(script: 'test -s git-status.txt && echo si || echo no', returnStdout: true).trim()
        }
        echo "Hay cambios: ${env.HAY_CAMBIOS}"
      }
    }
 
    stage('Commit, push y Pull Request') {
      when {
        expression { env.HAY_CAMBIOS == 'si' }
      }
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-pat', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
          sh '''
            git config user.name "qwen-jenkins-bot"
            git config user.email "qwen-jenkins-bot@users.noreply.github.com"
 
            # Se excluyen explicitamente los archivos de trabajo que el propio
            # pipeline va dejando en el workspace (insumo, prompts, logs, scripts
            # auxiliares). Solo se sube lo que Qwen realmente toco en el codigo.
            git add -A -- . \
              ':!insumo.bin' \
              ':!hallazgos.txt' \
              ':!prompt.txt' \
              ':!cambios.txt' \
              ':!resumen.txt' \
              ':!diff-stat.txt' \
              ':!git-status.txt' \
              ':!litellm-config.yaml' \
              ':!convertir_insumo.py' \
              ':!crear_pr.py'
 
            echo "== Lo que va a quedar en el commit =="
            git diff --cached --stat
 
            git commit -m "Qwen: corrige hallazgos de $FUENTE (severidad $SEVERIDAD_FILTRO)"
 
            REPO_PATH=$(echo "$REPO_URL" | sed -E 's#https://github.com/##; s#\\.git$##')
            git push "https://${GH_USER}:${GH_TOKEN}@github.com/${REPO_PATH}.git" "$FIX_BRANCH"
          '''
 
          writeFile file: 'crear_pr.py', text: '''
import json
import os
import urllib.request
import urllib.error
 
gh_token = os.environ["GH_TOKEN"]
repo_url = os.environ["REPO_URL"]
base_branch = os.environ["REPO_BRANCH"]
fix_branch = os.environ["FIX_BRANCH"]
fuente = os.environ.get("FUENTE", "DESCONOCIDO")
 
repo_path = repo_url.replace("https://github.com/", "").replace(".git", "")
 
def leer(path):
    if os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            return f.read()
    return ""
 
hallazgos = leer("hallazgos.txt")
diff_stat = leer("diff-stat.txt")
resumen_qwen = leer("cambios.txt")
 
body = (
    f"PR generado automaticamente por Qwen a partir de hallazgos de {fuente}.\\n\\n"
    f"## Archivos tocados\\n```\\n{diff_stat}\\n```\\n\\n"
    f"## Hallazgos que se intentaron corregir\\n```\\n{hallazgos}\\n```\\n\\n"
    f"## Resumen de Qwen\\n{resumen_qwen}\\n\\n"
    f"---\\nRevisar los cambios antes de mergear. Este PR no se mergea automaticamente."
)
 
payload = {
    "title": f"Qwen: corrige deuda tecnica/vulnerabilidades ({fuente})",
    "head": fix_branch,
    "base": base_branch,
    "body": body,
}
 
req = urllib.request.Request(
    f"https://api.github.com/repos/{repo_path}/pulls",
    data=json.dumps(payload).encode("utf-8"),
    headers={
        "Authorization": f"Bearer {gh_token}",
        "Accept": "application/vnd.github+json",
        "Content-Type": "application/json",
    },
    method="POST",
)
 
try:
    with urllib.request.urlopen(req) as resp:
        result = json.loads(resp.read().decode("utf-8"))
        print("PR creado:", result.get("html_url"))
except urllib.error.HTTPError as e:
    print("Error creando el PR:", e.code, e.read().decode("utf-8"))
    raise
'''
          sh '''
            docker run --rm --user root \
              -v "$(pwd):$(pwd)" \
              -w "$(pwd)" \
              -e GH_TOKEN=$GH_TOKEN \
              -e REPO_URL="$REPO_URL" \
              -e REPO_BRANCH="$REPO_BRANCH" \
              -e FIX_BRANCH="$FIX_BRANCH" \
              -e FUENTE="$FUENTE" \
              python:3.11-slim \
              python3 crear_pr.py
          '''
        }
      }
    }
 
    stage('Sin cambios') {
      when {
        expression { env.HAY_CAMBIOS == 'no' }
      }
      steps {
        echo 'Qwen no modifico ningun archivo (probablemente marco todo como falso positivo). No se crea rama ni PR.'
      }
    }
  }
 
  post {
    always {
      sh 'docker rm -f litellm-proxy-temp || true'
      archiveArtifacts artifacts: 'cambios.txt, hallazgos.txt, diff-stat.txt', fingerprint: true, allowEmptyArchive: true
    }
  }
}
